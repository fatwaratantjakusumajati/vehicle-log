# ===================================================================================
# .env.example - Template konfigurasi untuk aw.py (cam1 + cam2)
# Salin file ini menjadi .env lalu sesuaikan nilainya dengan konfigurasi Anda.
# JANGAN PERNAH MENYIMPAN PASSWORD ATAU IP ASLI DI REPOSITORI PUBLIK.
# ===================================================================================

# ----- KAMERA (NVR / RTSP) -----
CAMERA_USER=admin
CAMERA_PASS=your_camera_password
CAMERA_HOST=192.168.1.xxx
CAMERA_PORT=554
CAM1_CHANNEL=101
CAM2_CHANNEL=301
CAMERA_HTTP_PORT=80
CAM2_CONFIDENCE_MIN=0.15
CAM2_FRAME_SKIP=1

# ----- n8n / Webhook Integration -----
N8N_WEBHOOK_URL=http://localhost:5678/webhook/vehicle-log
N8N_TIMEOUT_SECONDS=10
N8N_RETRY_ATTEMPTS=3
N8N_RETRY_DELAY_SECONDS=3
N8N_OUTBOX_PATH=n8n_outbox.jsonl
N8N_OUTBOX_MAX_MB=500
N8N_OUTBOX_INTERVAL_SECONDS=30

# ----- LOGGING -----
LOG_MAX_MB=100
LOG_KEEP_FILES=14

# ----- MODEL DETEKSI YOLO (OpenVINO) -----
MODEL_PATH=yolo11n_openvino_model
CONFIDENCE_MIN=0.40
IOU_THRESHOLD=0.45

# ----- CAM1 (Loading Dock Monitor) -----
CARGO_MODEL_PATH=cargo_model.pkl
CARGO_MIN_CROP_SIDE=70
CARGO_MIN_CROP_PIXELS=8000
CARGO_ML_VERBOSE=0
CAM1_FPS=4
CAM1_MAX_SESSIONS=4
CAM1_DEFAULT_DIRECTION=
CAM1_MIN_CONF=0.40
CAM1_TRACK_CONF=0.15
CAM1_ENTRY_SECONDS=5.0
CAM1_MOVING_GRACE=45
CAM1_PARKED_GRACE=60
CAM1_PARK_CONFIRM=30
CAM1_DELTA_STRONG=0.15
CAM1_DELTA_WEAK=0.08
CARGO_ML_CONF=0.70
CARGO_ML_MARGIN=0.15
CARGO_SOFTEN_T=6
CAM1_REVIEW_MIN=0.40
CAM1_ANNOUNCE_MIN_SAMPLES=2
CAM1_FK_MODEL=forklift_openvino_model

# ----- CAM2 (Halaman Depan / Gate) -----
CONFIRM_SECONDS=3.0
ENTRY_STATIONARY_CONFIRM_SECONDS=2
LOST_SECONDS=10.0
RELINK_WINDOW_SECONDS=30.0
RELINK_MAX_CENTER_DIST_RATIO=0.8
TRACK_RELINK_GRACE_SECONDS=12
TRACK_MATCH_MAX_CENTER_RATIO=0.20
TRACK_MATCH_MIN_SIZE_RATIO=0.40
TRACK_MATCH_MIN_IOU=0.15
MAX_TRACK_ALIASES=8
TRACK_MATCH_MAX_SIZE_RATIO=2.20
REVISIT_RETENTION_SECONDS=600
MIN_GENUINE_REVISIT_GAP_SECONDS=300
REVISIT_MIN_APPEARANCE_SCORE=0.45
REVISIT_MAX_DIST_CAP_PIXELS=500
STATIONARY_LOST_SECONDS=30
SHADOW_FILTER_ENABLE=false
DEBUG_MODE=false

# ----- AKTIVITAS (activity_estimator.py) -----
ACTIVITY_STATIONARY_THRESHOLD=20
ACTIVITY_MODE=true
ACT_DELTA_MIN=0.30
ACT_PHASE_SAMPLES=6
ACT_MIN_PHASE_SAMPLES=2
ACT_MIN_SEPARATION_SECONDS=8
ACT_FORKLIFT_NEAR_SECONDS=10
ACT_EMPTY_ARRIVAL_MAX=0.30
ACT_EMPTY_STAY_LOADING=1
ACT_DELTA_MIN_FK=0.12
ACTIVITY_LABEL_IN_JENIS=0
ACTIVITY_EVENTS_SEND=0
